# Production site origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml
# Set this to your final custom Vercel domain, e.g. https://innovationlab.iilm.edu
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public browser variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Server-only — never expose these to the browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Profile photos upload directly from the browser to Cloudinary using a short-lived signed configuration.
# Vercel never receives the image bytes; Supabase stores only the returned HTTPS URL.
# The Cloudinary API secret stays server-side and must never use a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Forms (leave blank until official forms are supplied)
NEXT_PUBLIC_EXPLORER_FORM_URL=
NEXT_PUBLIC_IDEATOR_FORM_URL=
NEXT_PUBLIC_CAMPUS_INNOVATION_FORM_URL=
NEXT_PUBLIC_SOCIAL_MEDIA_FORM_URL=

# Optional webmaster verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Admin Studio uses Supabase Auth individual accounts; do not add a shared admin password here.
NEXT_PUBLIC_EXPLORER_WHATSAPP_URL=

# Optional web-push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Supabase Edge Function secrets (set in Supabase, not Vercel):
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Public Cloudinary cloud name (same value as CLOUDINARY_CLOUD_NAME; it is not a secret). Used to deliver site photos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xkrpqbdt
